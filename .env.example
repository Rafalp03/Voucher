# Skopiuj ten plik do .env i uzupełnij wartości:
#   cp .env.example .env
# Plik .env nie trafia do repozytorium.

# Uwaga: Postgres ustawia hasło tylko przy pierwszym starcie (pustym wolumenie).
# Po zmianie hasła trzeba usunąć dane bazy: docker compose down -v
POSTGRES_USER=voucher
POSTGRES_PASSWORD=zmien_mnie
POSTGRES_DB=voucher

# Port bazy na Twoim komputerze (np. dla DBeavera). Zmień, jeśli jest zajęty.
POSTGRES_PORT=5433

# Klucz do podpisywania tokenów logowania (JWT), min. 32 znaki.
# Wygeneruj własny, np.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=zmien_mnie_na_losowy_ciag_min_32_znakow

# Adresy frontendu, z których przeglądarka może wołać API (CORS), oddzielone przecinkami.
# Domyślnie: localhost na portach 8080, 5500 i 3000. Odkomentuj, żeby zmienić.
# CORS_ORIGINS=http://localhost:8080,https://twoja-domena.pl
